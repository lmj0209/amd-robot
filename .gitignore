# ---- Large artifacts: store externally and track them via a manifest ----
# Pinned Menagerie source directories are fetched as complete, ignored trees.
assets/menagerie/unitree_go2/
assets/menagerie/unitree_z1/
*.npz
*.npy
*.pt
*.pkl
*.ckpt
*.safetensors
*.h5
*.mp4
*.mov
*.avi
*.mkv
*.usd
*.usda
*.usdc
*.dae
*.stl
*.obj
*.glb
*.png
*.jpg
*.jpeg
*.zip
*.tar
*.tar.gz
*.7z

# Experiment outputs: keep only the reproducibility metadata in Git.
experiments/*
!experiments/README.md
!experiments/**/
!experiments/**/config.yaml
!experiments/**/manifest.json
!experiments/**/result.md
artifacts/*
!artifacts/README.md
!artifacts/manifest.json

# Evaluator-facing figures are intentionally versioned.
!benchmarks/figures/*.png
!benchmarks/figures/*.jpg
!docs/**/*.png
!docs/**/*.jpg
!report/**/*.png
!report/**/*.jpg

# Only explicitly approved redistributable assets may bypass mesh ignores.
!assets/redistributable/**

# Logs / tracking
wandb/
runs/
*.log
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

